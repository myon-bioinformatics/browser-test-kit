{
  "schema": "btk-platform-adapter/1",
  "id": "flutter-counter",
  "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/examples/counter-playground",
  "flutter_semantics": true,
  "provenance": {
    "path": "assets/assets/diagnostics/build_metadata.json",
    "field": [
      "repository",
      "revision",
      "sha"
    ]
  },
  "elements": [
    "[flt-semantics-identifier=\"shared-header-title\"]",
    "[flt-semantics-identifier=\"shared-header-home\"]",
    "[flt-semantics-identifier=\"shared-header-favorite\"] [role=\"button\"]",
    "[flt-semantics-identifier=\"shared-header-menu\"]",
    "[data-btk-probe=\"increase\"]",
    "[data-btk-probe=\"decrease\"]"
  ],
  "click": {
    "target": "[data-btk-probe=\"increase\"]",
    "observe": "[data-btk-probe=\"reset\"]",
    "attribute": "aria-disabled",
    "before": "true",
    "after": null
  },
  "bindings": {
    "increase": {
      "selector": "flt-semantics[role=\"button\"]",
      "text": "Increase"
    },
    "decrease": {
      "selector": "flt-semantics[role=\"button\"]",
      "text": "Decrease"
    },
    "reset": {
      "selector": "flt-semantics[role=\"button\"]",
      "text": "Reset"
    }
  }
}
