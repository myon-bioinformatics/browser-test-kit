{
  "schema": "btk-platform-adapter/1",
  "id": "flutter-home",
  "url": "https://myon-bioinformatics.github.io/flutter_navigation_basic/#/",
  "flutter_semantics": true,
  "elements": [
    "[flt-semantics-identifier=\"shared-header-title\"]",
    "[flt-semantics-identifier=\"shared-header-home\"]",
    "[flt-semantics-identifier=\"shared-header-favorite\"] [role=\"button\"]",
    "[flt-semantics-identifier=\"shared-header-menu\"]"
  ],
  "click": {
    "target": "[flt-semantics-identifier=\"shared-header-favorite\"] [role=\"button\"]",
    "observe": "[flt-semantics-identifier=\"shared-header-favorite\"] [role=\"button\"]",
    "attribute": "textContent",
    "before": "Favorite this page",
    "after": "Remove favorite"
  }
}
